--conf
<TEST_HOME>/.rc-test-cage-workspace.yaml
--name
<TEST_HOME>-workspace
--log-level
trace
--net-default
deny
--net-rule
allow@api.github.com:tcp:443
--net-rule
allow@doltremoteapi.dolthub.com:tcp:443
--net-rule
allow@files.pythonhosted.org:tcp:443
--net-rule
allow@github.com:tcp:443
--net-rule
allow@pypi.org:tcp:443
--label
rc.source.path=<TEST_HOME>/workspace
--label
rc.auth.credential-mounts=real
--label
rc.auth.credential-mounts.claude=real
--label
rc.auth.credential-mounts.pi=real
--label
rc.cage-conf=<TEST_HOME>/.rc-test-cage-workspace.yaml
--label
rc.cage-conf-sha=<SHA256>
--label
rc.symlink-follow-fingerprint=ec6a1aac36ef0b705629fbe9627f6ce080c0b1b1335b5dacdd544333b2c6e8f4
-e
RC_MULTIPLEXER=none
--label
rc.session.multiplexer=none
--workdir
/workspace
-e
PI_CODING_AGENT_DIR=/home/agent/.pi/agent
-v
<TEST_HOME>/.pi/agent/auth.json:/home/agent/.pi/agent/auth.json
-e
CAGE_HOST_ADDR=host.microsandbox.internal
-v
<TEST_HOME>/.claude/projects:/home/agent/.claude/projects
-v
<TEST_HOME>/.claude/sessions:/home/agent/.claude/sessions
-e
RC_HOST_PROJECT_KEY=<TEST_HOME_SLUG>-workspace
--cpus=2
--memory=4g
--label
rc.egress.config-override=false