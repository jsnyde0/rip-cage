# postgres-pgvector — paste into your own Dockerfile, between FROM and USER agent.
#
# A Postgres 17 + pgvector cluster running as a plain unprivileged process inside
# ONE cage, so a caged agent can run a DB-backed test suite with no container
# runtime in the cage and no change to the containment floor. Same pattern the
# GitHub Actions runner images use.
#
# Cost: about +87 MiB on the built image (measured, 935.5 -> 1022.1 MiB). Both
# packages come from Debian trixie main, so there is no third-party apt repo and
# no signing key to trust. Reach for PGDG only if you need a version trixie does
# not ship.
#
# NOTE ON WHAT THIS USED TO BE: the manifest era had no way to get a file into
# the image, so the launcher and the smoke test were base64 blobs inside a
# single-line install_cmd, generated by a script nobody could read the output of.
# They are two COPY lines now. That collapse is most of why the manifest retired.

USER root
# create_main_cluster = false: postgresql-common would otherwise stand up a
# default "main" cluster that sits unused on the same port.
RUN mkdir -p /etc/postgresql-common \
    && echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.conf \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-17 postgresql-17-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Root-owned, agent-executable. The agent runs the launcher but cannot edit it.
COPY postgres-start.sh /usr/local/lib/rip-cage/postgres-pgvector-start.sh
COPY smoke.sh /usr/local/lib/rip-cage/recipe-tests/postgres-pgvector-smoke.sh
RUN chown root:root /usr/local/lib/rip-cage/postgres-pgvector-start.sh \
                    /usr/local/lib/rip-cage/recipe-tests/postgres-pgvector-smoke.sh \
    && chmod 0755 /usr/local/lib/rip-cage/postgres-pgvector-start.sh \
                  /usr/local/lib/rip-cage/recipe-tests/postgres-pgvector-smoke.sh

# PGDATA. Created root, handed to the agent — initdb runs at FIRST START, not at
# build; see the README for why that is deliberate.
RUN mkdir -p /var/lib/rip-cage-daemon/postgres-pgvector \
    && chown -R agent:agent /var/lib/rip-cage-daemon/postgres-pgvector

COPY boot-fragment.json /tmp/postgres-boot.json
RUN rc-boot-merge /tmp/postgres-boot.json && rm -f /tmp/postgres-boot.json
USER agent
