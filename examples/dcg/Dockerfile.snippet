# DCG (Destructive Command Guard) — paste into your own Dockerfile in TWO places.
#
# DCG is NOT floor (ADR-025 D2, ADR-026 D2) — it is a composable recipe. Without
# it, containment holds via the other layers; there is simply no destructive-
# command guard. USER root is required for the wiring block (every asset below
# is root-owned so the agent can run/read it but not replace or weaken it).
# Switch BACK to agent at the end of your Dockerfile — an extension that ends on
# root boots a root shell with every mount stranded (measured, rip-cage-ely4.16).

# --- paste this stage BEFORE your own `FROM ghcr.io/jsnyde0/rip-cage:latest` line ---
# Builds the dcg binary from source, pinned to v0.4.0, arch-adaptive (an arm64
# builder host produces an arm64 binary, an amd64 host an amd64 one — no cross
# compilation). The toolchain and source tree stay in this discarded stage; only
# the artifact crosses into the runtime image below.
FROM rust:1-slim-trixie AS dcg-builder
COPY build-dcg-from-source.sh /rc-build/build.sh
RUN chmod +x /rc-build/build.sh && /rc-build/build.sh

# --- paste this block between `FROM ghcr.io/jsnyde0/rip-cage:latest` and USER agent ---
USER root

COPY --from=dcg-builder /usr/local/bin/dcg /usr/local/bin/dcg
RUN chown root:root /usr/local/bin/dcg && chmod 0755 /usr/local/bin/dcg

# Guard wrapper engine (ADR-025 D3): pins CWD to a root-owned, .git-free dir so
# DCG's project-config discovery never walks up to /workspace; pins DCG_CONFIG
# to the cage-owned config below, suppressing the agent-writable user-layer
# config entirely; strips DCG_* override env vars; execs the pinned binary.
# NEVER call /usr/local/bin/dcg directly from a hook — always through this.
COPY dcg-guard /usr/local/lib/rip-cage/bin/dcg-guard
RUN chown root:root /usr/local/lib/rip-cage/bin/dcg-guard \
    && chmod 0755 /usr/local/lib/rip-cage/bin/dcg-guard

# Cage-owned DCG config + sentinel fixture (ADR-025 D5). config.toml's sole job
# is to parse successfully, which is what suppresses the user-layer config hole.
COPY config.toml /usr/local/lib/rip-cage/dcg/config.toml
COPY ripcage-testsentinel-rule.yaml /usr/local/lib/rip-cage/dcg/fixtures/ripcage-testsentinel-rule.yaml
RUN chown root:root /usr/local/lib/rip-cage/dcg/config.toml \
                    /usr/local/lib/rip-cage/dcg/fixtures/ripcage-testsentinel-rule.yaml \
    && chmod 0644 /usr/local/lib/rip-cage/dcg/config.toml \
                  /usr/local/lib/rip-cage/dcg/fixtures/ripcage-testsentinel-rule.yaml

# The pi-agent guard extension, on its OWN root-owned load path — not inside
# the agent's own ~/.pi/agent/extensions/, which stays agent-writable by design.
COPY dcg-gate.ts /etc/rip-cage/pi/dcg-gate.ts
RUN chown root:root /etc/rip-cage/pi /etc/rip-cage/pi/dcg-gate.ts \
    && chmod 0755 /etc/rip-cage/pi && chmod 0644 /etc/rip-cage/pi/dcg-gate.ts

# The recipe's own behavioral test, so `rc test` can prove the guard actually
# blocks (not just that it's present) — see tests/run-recipe-smokes.sh.
COPY smoke.sh /usr/local/lib/rip-cage/recipe-tests/dcg-smoke.sh
RUN chown root:root /usr/local/lib/rip-cage/recipe-tests/dcg-smoke.sh \
    && chmod 0755 /usr/local/lib/rip-cage/recipe-tests/dcg-smoke.sh

# Wires the guard into pi's launch (OPEN default — see README for the LOCKED
# opt-in). Claude Code reaches the guard through examples/claude/'s own
# managed-settings.json hook instead; compose that recipe for Claude Code cages.
COPY boot-fragment.json /tmp/dcg-boot.json
RUN rc-boot-merge /tmp/dcg-boot.json && rm -f /tmp/dcg-boot.json

USER agent
