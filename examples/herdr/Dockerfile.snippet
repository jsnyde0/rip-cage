# herdr multiplexer — paste into your own Dockerfile, between FROM and USER agent.
#
# herdr is a headless agent-supervisor with a unix-socket control surface and a
# TUI attach client. USER root is required (the binary and the scripted-attach
# helper are root-owned so the agent can execute but not replace them). Switch
# BACK to agent at the end of your Dockerfile — an extension that ends on root
# boots a root shell with every mount stranded (measured, rip-cage-ely4.16).
#
# Pinned release: github.com/ogulcancelik/herdr v0.9.0. Prebuilt binaries:
# herdr-linux-x86_64, herdr-linux-aarch64. SHA-256 checksums independently
# verified against the GitHub release API's asset digest field.

USER root
RUN ARCH=$(uname -m) \
    && if [ "$ARCH" = "aarch64" ]; then TARGET=aarch64; EXPECTED_SHA=9c8db20fb7e7427b138d5367113f1621ffd319f2f65d6f009e2594029115f0d2; \
       else TARGET=x86_64; EXPECTED_SHA=4fa1a01158dd8043da92d31b270780b0dcc10603038d9b61cac4d81ab63fb71f; fi \
    && curl -fsSL "https://github.com/ogulcancelik/herdr/releases/download/v0.9.0/herdr-linux-${TARGET}" -o /tmp/herdr \
    && echo "${EXPECTED_SHA}  /tmp/herdr" | sha256sum -c - \
    && install -m 755 /tmp/herdr /usr/local/bin/herdr \
    && rm -f /tmp/herdr

# Headless-PTY-attach helper (see README): triggers herdr's native roster
# restore, which does not fire on server start alone.
COPY scripted-attach.py /usr/local/bin/herdr-scripted-attach.py
RUN chown root:root /usr/local/bin/herdr-scripted-attach.py \
    && chmod 0755 /usr/local/bin/herdr-scripted-attach.py

COPY boot-fragment.json /tmp/herdr-boot.json
RUN rc-boot-merge /tmp/herdr-boot.json && rm -f /tmp/herdr-boot.json
USER agent
