#compdef rc

# _rc_completion_cage_names -- rip-cage-tsf2.5: enumerate rc-managed cage
# names for tab completion via the same msb/rc-native path `rc ls` itself
# uses, replacing the retired docker-based `ps` lookup (there is no docker daemon behind
# cages post-msb-cutover). Shells out to `rc --output json ls` (the real
# enumeration logic — label filtering, msb inspection -- lives there once;
# completion just consumes it) and extracts names with jq. Pass
# --running-only to restrict to cages with status "running" (mirrors the old
# docker's running-only vs all-containers `ps` split for attach/exec/down/test/reload vs
# destroy/doctor). Fails silently (empty completions) if rc or jq are
# unavailable -- same degrade-gracefully behavior as the old docker-based call.
_rc_completion_cage_names() {
  local filter='.[].name'
  [[ "${1:-}" == "--running-only" ]] && filter='.[] | select(.status=="running") | .name'
  command rc --output json ls 2>/dev/null | jq -r "$filter" 2>/dev/null
}

_rc() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a subcommands
  subcommands=(
    'build:Build the rip-cage image'
    'up:Start or resume a container'
    'ls:List rip-cage containers'
    'attach:Attach to container (multiplexer-aware)'
    'exec:Run a one-off command in the container'
    'down:Stop a container'
    'destroy:Remove container and volumes'
    'reload:Hot-reload .rip-cage.yaml allowlist changes'
    'test:Run safety stack smoke test'
    'doctor:Per-container diagnostic — labels + live probes'
    'auth:Auth subcommands (refresh)'
    'config:Inspect effective .rip-cage.yaml config'
    'schema:Print machine-readable command schema'
    'completions:Print shell completion script'
    'setup:Interactive shell integration setup'
  )

  _arguments -C \
    '1: :->subcmd' \
    '*: :->args'

  case $state in
    subcmd)
      _describe 'subcommand' subcommands
      ;;
    args)
      case $line[1] in
        attach|exec|down|test|reload)
          local -a containers
          containers=($(_rc_completion_cage_names --running-only))
          _describe 'container' containers
          ;;
        destroy|doctor)
          local -a containers
          containers=($(_rc_completion_cage_names))
          _describe 'container' containers
          ;;
        up)
          _files -/
          ;;
        auth)
          local -a auth_subcmds
          auth_subcmds=('refresh:Refresh credentials from host keychain')
          _describe 'auth subcommand' auth_subcmds
          ;;
        config)
          local -a config_subcmds
          config_subcmds=(
            'show:Print effective merged config (add --json for machine output)'
            'get:Print one effective config value (dotted.key)'
            'set:Set a scalar/enum value (--scope global|project)'
            'add:Add a list item (--scope global|project)'
            'remove:Remove a list item (--scope global|project)'
          )
          _describe 'config subcommand' config_subcmds
          ;;
        completions)
          local -a shells
          shells=('zsh:Zsh completion script' 'bash:Bash completion script')
          _describe 'shell' shells
          ;;
      esac
      ;;
  esac
}

_rc
