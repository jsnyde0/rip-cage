#!/usr/bin/python3 -I
"""host-tool -- the in-cage client of the host-tool line (ADR-032 D6).

    host-tool [--json] <tool> <verb> [--<slot> <value> | --<slot>=<value>]...
    host-tool [--json] --list

A convenience door, not a boundary: every decision is the gatekeeper's. The
client never validates a value; it only encodes an int slot's text as a JSON
integer when it is one (typed from the `list` reply) and relays the answer.

Python 3 standard library only; the -I shebang keeps the agent's own
site-packages and PYTHON* variables out of this guarded client.

Exit codes: 0 ok; 2 refused, nothing ran (also usage errors); 3 ran and failed
or reply withheld; 4 answered but could not run; 5 the line did not answer: either
at the connect stage or with a bad list reply (the three-cause NO_ANSWER
message, nothing was sent that could run), or after the call request was
delivered (the STOPPED_ANSWERING message: the command may have run).

Rules this file fixes (the ADR leaves them to the client):
  * ok result is printed to stdout followed by a newline unless it already
    ends with one.
  * connect timeout 2 s; list reply timeout 10 s; call reply timeout is the
    verb's listed timeout + REPLY_GRACE (5 s), 30 s listed when the verb is
    not in the list (the gatekeeper then answers no-such-tool/verb at once).
  * a call reply that is not a JSON object, an error kind outside the closed
    vocabulary, a non-string result, a reset or a missed deadline after the
    request was sent: exit 5 with the STOPPED_ANSWERING line (the command may
    have run). Connect-stage failures and a bad list reply keep NO_ANSWER.
  * a repeated --<slot> is a usage error (exit 2), never a silent overwrite.
"""
import json
import math
import os
import re
import socket
import sys
import time

# Duplicated from cli/lib/host_tools.sh RC_HOST_TOOL_PORT; change both.
PORT = 7700

CONNECT_TIMEOUT = 2
LIST_REPLY_TIMEOUT = 10
REPLY_GRACE = 5
UNLISTED_VERB_TIMEOUT = 30
MAX_SOCKET_WAIT = 31536000  # clamp only what settimeout() can hold; the listed timeout itself has no ceiling
MAX_REPLY_BYTES = 1 << 20  # the gatekeeper caps replies at 32 KiB; this is a leash

# HOST_TOOL_SOCKET=<unix socket path> dials AF_UNIX instead of AF_VSOCK. It is
# honoured ONLY so tests can inject a fake gatekeeper; nothing else is
# configurable, and the default (unset) is the vsock to the host.
TEST_SOCKET_VAR = "HOST_TOOL_SOCKET"

# Failure AFTER the call request was delivered: the command may have run, so the
# agent must not retry a side-effecting verb believing it did not (ADR-032 D3).
STOPPED_ANSWERING = (
    "host-tool line stopped answering after the request was sent; the command "
    "may have run. Operator: run rc doctor on this cage."
)

NO_ANSWER = (
    "host-tool line did not answer. Causes: no <cage>.tools.yaml declared for "
    "this cage; declaration added but the cage not recreated yet; or the "
    "gatekeeper is down. Operator: run rc doctor on this cage."
)

EXIT_BY_KIND = {
    "no-such-tool": 2,
    "no-such-verb": 2,
    "bad-argument": 2,
    "request-too-large": 2,
    "tool-failed": 3,
    "reply-too-large": 3,
    "timeout": 4,
    "busy": 4,
    "unavailable": 4,
}

INT_TEXT = re.compile(r"-?[0-9]+")  # used with fullmatch: `$` would admit a trailing newline


class NoAnswer(Exception):
    """The line gave no usable answer. after_send: the call request was delivered."""

    def __init__(self, after_send=False):
        Exception.__init__(self)
        self.after_send = after_send


def esc(value):
    """One printable line: control characters become their repr escapes."""
    return "".join(c if c.isprintable() else repr(c)[1:-1] for c in str(value))


def die(code, msg):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def usage(msg):
    die(2, "host-tool: " + msg + " (usage: host-tool [--json] <tool> <verb> [--<slot> <value>]... | host-tool [--json] --list)")


def exchange(request, reply_timeout, call=False):
    """One request per connection: connect, send line, shut write, read one line."""
    path = os.environ.get(TEST_SOCKET_VAR)
    sent = False
    try:
        if path:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        else:
            s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
        with s:
            s.settimeout(CONNECT_TIMEOUT)
            if path:
                s.connect(path)
            else:
                s.connect((socket.VMADDR_CID_HOST, PORT))
            deadline = time.monotonic() + reply_timeout
            s.settimeout(min(reply_timeout, MAX_SOCKET_WAIT))
            s.sendall(json.dumps(request, separators=(",", ":")).encode() + b"\n")
            sent = call
            s.shutdown(socket.SHUT_WR)
            buf = b""
            while b"\n" not in buf and len(buf) < MAX_REPLY_BYTES:
                left = deadline - time.monotonic()
                if left <= 0:
                    raise NoAnswer(sent)
                s.settimeout(min(left, MAX_SOCKET_WAIT))
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except (OSError, AttributeError):
        # refused, reset, timed out, no such socket, or no AF_VSOCK here
        raise NoAnswer(sent)
    line = buf.split(b"\n", 1)[0]
    try:
        text = line.decode("utf-8")
        return text, json.loads(text)
    except ValueError:
        raise NoAnswer(sent)


def fetch_list():
    """Returns (raw_line, reply_obj); reply is an answer (maybe busy)."""
    raw, reply = exchange({"v": 1, "list": True}, LIST_REPLY_TIMEOUT)
    if not isinstance(reply, dict) or "ok" not in reply:
        raise NoAnswer()
    return raw, reply


def relay_error(raw, reply, as_json, after_send=False):
    err = reply.get("error")
    kind = err.get("kind") if isinstance(err, dict) else None
    if not isinstance(kind, str) or kind not in EXIT_BY_KIND:
        raise NoAnswer(after_send)
    if as_json:
        print(raw)
    else:
        sys.stderr.write("error: %s: %s\n" % (kind, esc(err.get("message", ""))))
    sys.exit(EXIT_BY_KIND[kind])


def tools_of(reply):
    result = reply.get("result")
    tools = result.get("tools") if isinstance(result, dict) else None
    return tools if isinstance(tools, dict) else {}


def render_list(reply):
    lines = []
    for tool in sorted(tools_of(reply)):
        lines.append(tool)
        verbs = tools_of(reply)[tool]
        for verb in sorted(verbs if isinstance(verbs, dict) else {}):
            spec = verbs[verb] if isinstance(verbs[verb], dict) else {}
            slots = spec.get("slots") if isinstance(spec.get("slots"), dict) else {}
            slot_text = " ".join("%s:%s" % (n, slots[n]) for n in sorted(slots))
            line = "  %s  (timeout %ss)" % (verb, spec.get("timeout", "?"))
            if slot_text:
                line += "  " + slot_text
            lines.append(line)
    return "\n".join(lines)


def parse(argv):
    as_json = False
    want_list = False
    i = 0
    while i < len(argv) and argv[i].startswith("--"):
        if argv[i] == "--json":
            as_json = True
        elif argv[i] == "--list":
            want_list = True
        else:
            usage("unknown option %s (only --list and --json, before <tool>)" % argv[i])
        i += 1
    rest = argv[i:]
    if want_list:
        if rest:
            usage("--list takes no tool or verb")
        return as_json, True, None, None, {}
    if len(rest) < 2:
        usage("need <tool> <verb>")
    tool, verb = rest[0], rest[1]
    if tool.startswith("-") or verb.startswith("-"):
        usage("<tool> and <verb> come before any --<slot>")
    slots = {}
    j = 2
    while j < len(rest):
        tok = rest[j]
        if not tok.startswith("--") or len(tok) == 2:
            usage("stray token %r (slots are --<name> <value>)" % tok)
        if "=" in tok:
            name, value = tok[2:].split("=", 1)
            j += 1
        else:
            name = tok[2:]
            if j + 1 >= len(rest):
                usage("--%s needs a value" % name)
            value = rest[j + 1]  # always consumed, whatever it starts with
            j += 2
        if not name:
            usage("empty slot name")
        if name in slots:
            usage("--%s given twice" % name)
        slots[name] = value
    return as_json, False, tool, verb, slots


def main(argv):
    as_json, want_list, tool, verb, slots = parse(argv)
    try:
        raw, reply = fetch_list()
        if reply.get("ok") is not True:
            relay_error(raw, reply, as_json)
        if want_list:
            print(raw if as_json else render_list(reply))
            return 0

        spec = None
        verbs = tools_of(reply).get(tool)
        if isinstance(verbs, dict) and isinstance(verbs.get(verb), dict):
            spec = verbs[verb]
        types = {}
        timeout = UNLISTED_VERB_TIMEOUT
        if spec is not None:
            timeout = spec.get("timeout")
            if (not isinstance(timeout, (int, float)) or isinstance(timeout, bool)
                    or not math.isfinite(timeout) or not timeout > 0):
                raise NoAnswer()  # unusable timeout in the list reply: a bad list reply
            if isinstance(spec.get("slots"), dict):
                types = spec["slots"]
        args = {}
        for name, value in slots.items():
            if types.get(name) == "int" and INT_TEXT.fullmatch(value):
                args[name] = int(value)
            else:
                args[name] = value
        request = {"v": 1, "tool": tool, "verb": verb, "args": args}
        raw, reply = exchange(request, timeout + REPLY_GRACE, call=True)
        if not isinstance(reply, dict) or "ok" not in reply:
            raise NoAnswer(True)
        if reply.get("ok") is not True:
            relay_error(raw, reply, as_json, after_send=True)
        result = reply.get("result", "")
        if not isinstance(result, str):
            raise NoAnswer(True)  # exit code decided before any output, in both modes
        if as_json:
            print(raw)
        else:
            sys.stdout.write(result if result.endswith("\n") else result + "\n")
        return 0
    except NoAnswer as exc:
        die(5, STOPPED_ANSWERING if exc.after_send else NO_ANSWER)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
